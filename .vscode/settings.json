      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },
  "files.associations": {
    "dbt_project/*.sql": "jinja-sql",
    "dbt_project/**/*.sql": "jinja-sql",
    "dbt_project/*.yml": "jinja-yaml",
    "dbt_project/**/*.yml": "jinja-yaml",
    "dbt_project/*.yaml": "jinja-yaml",
    "dbt_project/**/*.yaml": "jinja-yaml"
  },
  "files.watcherExclude": {
    "**/.git/**": true,
    "**/.venv/**": true,
    "**/lending-club-venv/**": true,
    "**/lending-club-venv-py312/**": true,
    "**/.dvc/cache/**": true,
    "**/.pytest_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/dbt_project/target/**": true,
    "**/reports/notebook_images/**": true,
    "**/dist/**": true,
    "**/catboost_info/**": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/lending-club-venv": true,
    "**/lending-club-venv-py312": true,
    "**/.dvc/cache": true,
    "**/dbt_project/target": true,
    "**/reports/notebook_images": true,
    "**/dist": true
  },
  "jupyter.notebookFileRoot": "${workspaceFolder}",
  "jupyter.askForKernelRestart": false,
  "ruff.importStrategy": "fromEnvironment",
  "ruff.interpreter": [
    "/home/eigenlinux/projects/lending-club-risk-project/lending-club-venv/bin/python"
  ],
  "ruff.path": [
    "/home/eigenlinux/projects/lending-club-risk-project/lending-club-venv/bin/ruff"
  ],
  "ruff.nativeServer": "auto",
  "dbt.dbtIntegration": "core",
  "dbt.dbtPythonPathOverride": "/home/eigenlinux/projects/lending-club-risk-project/lending-club-venv/bin/python",
  "dbt.allowListFolders": [
    "dbt_project"
  ],
  "dbt.installDepsOnProjectInitialization": false,
  "dbt.enableCollaboration": false,
  "dbt.enableNotebooks": false,
  "dbt.queryLimit": 1000,
  "sqltools.connections": [
    {
      "name": "Lending Club DuckDB",
      "group": "Project",
      "driver": "DuckDB",
      "database": "/home/eigenlinux/projects/lending-club-risk-project/data/lending_club.duckdb",
      "previewLimit": 1000
    },
    {
      "name": "Optuna PD SQLite",
      "group": "Project",
      "driver": "SQLite",
      "database": "/home/eigenlinux/projects/lending-club-risk-project/models/optuna_pd_catboost.db",
      "previewLimit": 1000
    }
  ],
  "containers.containerClient": "com.microsoft.visualstudio.containers.docker",
