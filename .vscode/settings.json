{
  "python.defaultInterpreterPath": "/home/eigenlinux/projects/lending-club-risk-project/lending-club-venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.envFile": "${workspaceFolder}/.env",
  "terminal.integrated.env.linux": {
    "UV_PROJECT_ENVIRONMENT": "/home/eigenlinux/projects/lending-club-risk-project/lending-club-venv"
  },
  "dvc.focusedProjects": [
    "/home/eigenlinux/projects/lending-club-risk-project"
  ],
  "dvc.pythonPath": "/home/eigenlinux/projects/lending-club-risk-project/lending-club-venv/bin/python",
